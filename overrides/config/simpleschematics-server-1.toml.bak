#Creative world work budget per tick, in microseconds. Storage runs separately.
# Default: 4000
# Range: 250 ~ 25000
creativeTickMicros = 4000
#Maximum operations per tick, in addition to the time budget; not a schematic size limit.
# Default: 8192
# Range: 64 ~ 1000000
creativeStepsPerTick = 8192
#Decoded undo data budget per player per world; at most ten records are retained.
# Default: 64
# Range: 1 ~ 1024
creativeHistoryMiB = 64
#Decoded Creative undo data budget for the whole server world.
# Default: 512
# Range: 1 ~ 4096
globalCreativeHistoryMiB = 512
#Maximum paid placement groups per game second for each job. Journalling, supplies and server load can make construction slower.
# Default: 200
# Range: 1 ~ 200
survivalMaxGroupsPerSecond = 200
#Shared paid job work budget per server tick, in microseconds.
# Default: 2000
# Range: 250 ~ 25000
survivalTickMicros = 2000
#Who may send schematics to the server for a Materials check, a Survival build, a Creative paste or a printer: everyone, operators (permission level 2) or nobody. Previews never send anything.
schematicSending = "everyone"
